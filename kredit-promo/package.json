{
  "name": "kredit-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Промо-ролик «Кредиттік жүйе» — Remotion + three.js",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render KreditPromo out/kredit-promo.mp4 --gl=angle",
    "render:sw": "remotion render KreditPromo out/kredit-promo.mp4 --gl=swangle",
    "still": "remotion still KreditPromo out/still.png --gl=angle",
    "check": "tsc --noEmit && tsx scripts/check-layout.ts"
  },
  "dependencies": {
    "@react-three/fiber": "8.18.0",
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/three": "4.0.538",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
